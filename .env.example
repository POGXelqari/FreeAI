# FreeAI Configuration & Credentials
# Rename this file to .env or set these environment variables in your shell.

# Primary Gmail Address for Plus-Aliasing (e.g. your_email+alias@gmail.com)
GMAIL_ADDRESS=your_email@gmail.com

# 16-Character Google App Password (generate at: https://myaccount.google.com/apppasswords)
# Required for autonomous IMAP magic link retrieval without manual clicking.
GMAIL_APP_PASSWORD=

# Optional Proxy Pool (e.g. Webshare 10 proxies.txt or single proxy URL)
# If empty, Direct Host Connection with Chrome TLS impersonation is used.
FREEAI_PROXIES=
